# Neon Serverless PostgreSQL Connection String
# Get your free connection string from: https://console.neon.tech
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require

DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Cloudinary image storage (optional — without it uploads fall back to public/uploads/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
